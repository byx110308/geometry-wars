{
  "name": "geometry-wars",
  "version": "1.0.0",
  "description": "几何决斗 - 桌面版",
  "main": "main.js",
  "author": "Geometry Wars",
  "homepage": "https://gitee.com/byx0308/geometry-wars",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --mac --linux",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.geometrywars.app",
    "productName": "几何决斗",
    "icon": "icon.png",
    "files": [
      "main.js",
      "preload.js",
      "geometry-wars.html",
      "icon.png"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "${productName}-${version}-Windows便携版.${ext}"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "artifactName": "${productName}-${version}-macOS.${ext}",
      "category": "public.app-category.games",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": ["AppImage"],
      "artifactName": "${productName}-${version}-Linux.${ext}",
      "category": "Game"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
